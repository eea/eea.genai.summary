<configure xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:genai="http://namespaces.eea.europa.eu/genai"
    i18n_domain="eea">

    <include package="eea.genai.core" />
    <include package="eea.genai.core" file="meta.zcml" />

    <include file="profiles.zcml" />

    <include package=".restapi" />

    <plone:behavior
        name="eea.genai.summary"
        title="LLM Summary"
        description="Adds LLM-powered summary generation fields to content types."
        provides="eea.genai.summary.behaviors.ILLMSummary"
    />

    <subscriber
        for="eea.genai.summary.behaviors.ILLMSummary
             zope.lifecycleevent.interfaces.IObjectModifiedEvent"
        handler=".subscribers.on_content_modified"
    />

    <!-- Creation: the REST/Volto upload path fires ObjectCreatedEvent (not
         ObjectModifiedEvent), so auto-generation also subscribes to create.
         The created handler only fires when the object carries actual image
         data at creation (Image uploads); the handler is idempotent, so a
         second event in the same request sees the already-set llm_summary
         and returns. -->
    <subscriber
        for="eea.genai.summary.behaviors.ILLMSummary
             zope.lifecycleevent.interfaces.IObjectCreatedEvent"
        handler=".subscribers.on_content_created"
    />

    <!-- Agent context providers -->

    <genai:agentContextProvider
        name="generic_metadata"
        class=".context_providers.GenericMetadataProvider"
    />

    <genai:agentContextProvider
        name="generic_metadata_no_dates"
        class=".context_providers.GenericMetadataNoDatesProvider"
    />

    <!-- Multimodal: attaches the image bytes of Image content to the prompt -->
    <genai:agentContextProvider
        name="image_content"
        class=".image.ImageContentProvider"
    />

    <!-- Default summarizer agent -->
    <genai:agent
        name="summarizer"
        class=".agents.SummarizerAgent"
    />

    <!-- Content-type-specific multimodal summarizer for Image -->
    <genai:agent
        name="summarizer:Image"
        class=".agents.ImageSummarizerAgent"
    />

</configure>