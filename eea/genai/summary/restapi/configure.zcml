<configure xmlns="http://namespaces.zope.org/zope" xmlns:plone="http://namespaces.plone.org/plone">

    <plone:service
        method="POST"
        for="eea.genai.summary.behaviors.ILLMSummary"
        factory=".post.LLMSummaryPost"
        name="@llm-summary"
        permission="cmf.ModifyPortalContent"
    />

    <plone:service
        method="POST"
        for="Products.CMFCore.interfaces.ISiteRoot"
        factory=".post.LLMSummaryBatchPost"
        name="@llm-summary-batch"
        permission="eea.genai.manage"
    />

    <plone:service
        method="POST"
        for="Products.CMFCore.interfaces.IFolderish"
        factory=".image.ImageMetadataPost"
        name="@image-metadata"
        permission="cmf.AddPortalContent"
    />

    <plone:service
        method="POST"
        for="plone.dexterity.interfaces.IDexterityContent"
        factory=".image.ImageMetadataRegeneratePost"
        name="@image-metadata-regenerate"
        permission="cmf.ModifyPortalContent"
    />

    <plone:service
        method="POST"
        for="plone.app.contenttypes.interfaces.IImage"
        factory=".image.ImageAltPost"
        name="@image-alt"
        permission="cmf.ModifyPortalContent"
    />

</configure>
